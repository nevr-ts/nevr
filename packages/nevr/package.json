    "@types/react": "^18.0.0",
    "express": "^4.18.2",
    "hono": "^4.11.0",
    "next": "^16.1.4",
    "react": "^18.0.0",
    "stripe": "^20.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.970.0",
    "@aws-sdk/s3-request-presigner": "^3.970.0",
    "@nanostores/react": ">=0.7.0",
    "@prisma/client": ">=5.0.0",
    "express": ">=4.0.0",
    "hono": ">=4.0.0",
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "stripe": "^20.1.2"
  },
