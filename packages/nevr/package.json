      "import": "./dist/plugins/auth/plugins/username/client.js",
      "types": "./dist/plugins/auth/plugins/username/client.d.ts"
    },
    "./plugins/auth/magic-link": {
      "import": "./dist/plugins/auth/plugins/magic-link/index.js",
      "types": "./dist/plugins/auth/plugins/magic-link/index.d.ts"
