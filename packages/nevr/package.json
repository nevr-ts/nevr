    },
    "@prisma/client": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "stripe": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "keywords": [
    "nevr",
    "zero-api",
    "entity-first",
    "type-safe",
    "crud-generator",
    "backend-automation",
    "backend",
    "framework",
    "typescript",
    "orm",
    "prisma",
    "express",
    "hono",
    "nextjs",
    "react",
    "authentication",
