  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jiti": "^2.4.2",
    "nanostores": "^0.10.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.970.0",
