      "import": "./dist/plugins/storage/client.js",
      "types": "./dist/plugins/storage/client.d.ts"
    },
    "./plugins/payment": {
      "import": "./dist/plugins/payment/index.js",
      "types": "./dist/plugins/payment/index.d.ts"
    },
    "./plugins/payment/client": {
      "browser": "./dist/plugins/payment/client.js",
      "import": "./dist/plugins/payment/client.js",
      "types": "./dist/plugins/payment/client.d.ts"
    },
    "./rag": {
      "import": "./dist/rag/index.js",
      "types": "./dist/rag/index.d.ts"
    },
    "./rag/client": {
      "browser": "./dist/rag/client.js",
      "import": "./dist/rag/client.js",
      "types": "./dist/rag/client.d.ts"
    },
    "./ai-gateway": {
      "import": "./dist/ai-gateway/index.js",
      "types": "./dist/ai-gateway/index.d.ts"
    },
    "./ai-gateway/client": {
      "browser": "./dist/ai-gateway/client.js",
      "import": "./dist/ai-gateway/client.js",
      "types": "./dist/ai-gateway/client.d.ts"
    },
    "./generator": {
      "import": "./dist/generator/index.js",
      "types": "./dist/generator/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
