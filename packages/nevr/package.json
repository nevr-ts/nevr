{
  "name": "nevr",
  "version": "0.3.3",
  "description": "The Entity-First Full Stack Framework for TypeScript. Define your entities, never write boilerplate again.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nevr": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./client/react": {
      "import": "./dist/client/react.js",
      "types": "./dist/client/react.d.ts"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts"
    },
    "./adapters/express": {
      "import": "./dist/adapters/express.js",
      "types": "./dist/adapters/express.d.ts"
    },
    "./adapters/hono": {
      "import": "./dist/adapters/hono.js",
      "types": "./dist/adapters/hono.d.ts"
    },
    "./drivers": {
      "import": "./dist/drivers/index.js",
      "types": "./dist/drivers/index.d.ts"
    },
    "./drivers/prisma": {
      "import": "./dist/drivers/prisma.js",
      "types": "./dist/drivers/prisma.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./plugins/auth": {
      "import": "./dist/plugins/auth/index.js",
      "types": "./dist/plugins/auth/index.d.ts"
    },
    "./plugins/auth/client": {
      "import": "./dist/plugins/auth/client.js",
      "types": "./dist/plugins/auth/client.d.ts"
    },
    "./plugins/auth/username": {
      "import": "./dist/plugins/auth/plugins/username.js",
      "types": "./dist/plugins/auth/plugins/username.d.ts"
    },
    "./plugins/timestamps": {
      "import": "./dist/plugins/timestamps.js",
      "types": "./dist/plugins/timestamps.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "nanostores": "^0.10.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@nanostores/react": "^0.7.0",
    "@prisma/client": "^5.22.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "express": "^4.18.2",
    "hono": "^4.11.0",
    "react": "^18.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@nanostores/react": ">=0.7.0",
    "@prisma/client": ">=5.0.0",
    "express": ">=4.0.0",
    "hono": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@nanostores/react": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "nevr",
    "zero-api",
    "entity-first",
    "type-safe",
    "crud-generator",
    "backend-automation",
    "backend",
    "framework",
    "typescript",
    "orm",
    "prisma",
    "express",
    "hono"
  ],
  "author": "Yalelet Dessalegn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nevr-ts/nevr"
  }
}